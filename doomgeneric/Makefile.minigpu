# Freestanding DoomGeneric build for MiniGPU prototype 42.
# Doom1.WAD stays local: pass DOOM_WAD=/path/to/doom.wad to override it.

MINI_CC ?= ../../tools/mini-cc
OUTDIR ?= ../../_build/c
DOOM_WAD ?= ../Doom1.WAD
OUTPUT ?= $(OUTDIR)/doom_minigpu.bin

CPPFLAGS := -D MINIGPU -D DOOMGENERIC_RESX=320 -D DOOMGENERIC_RESY=240 -I .
RUNTIME := ../../runtime/src/string.c ../../runtime/src/stdlib.c ../../runtime/src/stdio.c

CORE_OBJECTS := dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o i_input.o i_video.o doomgeneric.o
CORE_SOURCES := $(CORE_OBJECTS:.o=.c)

.PHONY: all clean

all: $(OUTPUT)

$(OUTPUT): $(CORE_SOURCES) minigpu_main.c doomgeneric_minigpu.c w_file_minigpu.c \
           w_file_minigpu.h $(RUNTIME) $(DOOM_WAD)

	$(MINI_CC) --far-calls $(CPPFLAGS) minigpu_main.c $(CORE_SOURCES) \
		doomgeneric_minigpu.c w_file_minigpu.c $(RUNTIME) \
		--data doom_wad=$(DOOM_WAD) --outdir $(OUTDIR) -o $(OUTPUT)

clean:
	rm -f $(OUTPUT) $(OUTPUT:.bin=.hex)
